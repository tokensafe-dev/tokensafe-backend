  "pushCases": [
    {
      "id": "sse-state-after-edit",
      "level": 2,
      "transport": "sse",
      "trigger": {
        "method": "oumv/applyEdit",
        "params": {
          "path": "${PUSH_FILE}",
          "mode": "create",
          "replacement": "${PUSH_CONTENT}"
        }
      },
      "expectEvents": [
        {
          "event": "state",
          "data": {
            "path": "${PUSH_FILE}",
            "operation": "create"
          }
        }
      ],
      "replay": {
        "expectEvents": [
          {
            "event": "state",
            "data": {
              "path": "${PUSH_FILE}",
              "operation": "create"
            }
          }
        ]
      }
    },
